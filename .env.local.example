# Public origin of the deployed site, e.g. https://yourneighbour.com
# Strongly recommended in production: Stripe Checkout's success/cancel URLs
# are built from this. Left unset, they fall back to the request's own
# forwarded Host header, which is attacker-supplied in principle.
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address on order emails, e.g. "Your Neighbour <orders@example.com>".
# REQUIRED IN PRODUCTION — the app throws rather than send without it.
#
# The address must sit on a domain verified at https://resend.com/domains,
# which means a domain whose DNS you control (verification publishes SPF and
# DKIM records under it). gmail.com and vercel.app can never be verified for
# that reason.
#
# Left unset, local development falls back to Resend's sandbox sender,
# onboarding@resend.dev. That sender delivers ONLY to the address the Resend
# account itself is registered under — every other recipient is rejected — so
# it is usable for local smoke tests and nothing else.
RESEND_FROM_EMAIL=

# Stripe — https://dashboard.stripe.com/apikeys (use test-mode keys locally)
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the webhook's signing
# secret in the Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# Any random string. Set this on the Vercel project and Vercel Cron will
# send it as a Bearer token to /api/keep-alive; the route rejects
# unauthenticated callers whenever it's set. Not needed locally.
CRON_SECRET=
