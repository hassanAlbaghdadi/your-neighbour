# Public origin of the deployed site, e.g. https://yourneighbour.com
# Strongly recommended in production: Stripe Checkout's success/cancel URLs
# are built from this. Left unset, they fall back to the request's own
# forwarded Host header, which is attacker-supplied in principle.
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use test-mode keys locally)
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the webhook's signing
# secret in the Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# Any random string. Set this on the Vercel project and Vercel Cron will
# send it as a Bearer token to /api/keep-alive; the route rejects
# unauthenticated callers whenever it's set. Not needed locally.
CRON_SECRET=
